{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateseal.dev/schemas/policy-v0alpha1.schema.json",
  "title": "StateSeal Policy",
  "type": "object",
  "required": ["version", "task", "state", "admission", "completion", "execution", "budget"],
  "properties": {
    "version": {"const": "v0alpha1"},
    "task": {
      "type": "object",
      "required": ["id", "goal"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "goal": {"type": "string"}
      }
    },
    "state": {"type": "object", "required": ["include", "protected"]},
    "admission": {"$ref": "#/$defs/checkSet"},
    "completion": {"allOf": [{"$ref": "#/$defs/checkSet"}]},
    "execution": {
      "type": "object",
      "required": ["clean_worktree", "network"],
      "properties": {
        "clean_worktree": {"const": true},
        "network": {"const": "inherit"}
      }
    },
    "budget": {"type": "object"},
    "residual_risks": {"type": "array", "items": {"type": "string"}},
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "scope", "owner", "reason", "expires_at"],
        "properties": {
          "rule": {"const": "PV001"},
          "scope": {"type": "string"},
          "owner": {"type": "string"},
          "reason": {"type": "string"},
          "expires_at": {"type": "string", "format": "date"}
        }
      }
    }
  },
  "$defs": {
    "checkSet": {
      "type": "object",
      "required": ["checks"],
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 0},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "command"],
            "properties": {
              "id": {"type": "string"},
              "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "cwd": {"type": "string"},
              "timeout_seconds": {"type": "integer", "minimum": 0},
              "layer": {"enum": ["L1", "L2", "L3"]},
              "origin": {"enum": ["auto-discovered", "project-policy", "external"]}
            }
          }
        }
      }
    }
  }
}
