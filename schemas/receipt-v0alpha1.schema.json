{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stateseal.dev/schemas/receipt-v0alpha1.schema.json",
  "title": "StateSeal Completion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "receipt_id", "task_id", "verdict", "enforcement_mode", "disposition", "policy_digest", "issued_by", "issued_at", "residual_risks", "receipt_digest"],
  "properties": {
    "receipt_version": {"const": "v0alpha1"},
    "receipt_id": {"type": "string", "pattern": "^rcpt_"},
    "task_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["ADMITTED", "REJECTED", "ABSTAINED", "STALE", "ESCALATED"]},
    "rule_id": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{3}$"},
    "enforcement_mode": {"enum": ["shadow", "warn", "enforce"]},
    "disposition": {"enum": ["OBSERVED", "OVERRIDDEN", "BLOCKED", "ALLOWED"]},
    "checkpoint_id": {"type": "string"},
    "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completion_evidence": {"type": "array", "items": {"type": "string"}},
    "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "issued_by": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "residual_risks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reason": {"type": "string"},
    "terminal_candidate": {"type": "string"},
    "selection_reason": {"type": "string"},
    "recovered": {"type": "boolean"},
    "verification_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "integrity_controls", "verifiers", "uncovered"],
      "properties": {
        "observation": {"type": "string"},
        "integrity_controls": {"type": "array", "items": {"type": "string"}},
        "verifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "phase", "layer", "origin", "status"],
            "properties": {
              "check_id": {"type": "string"},
              "phase": {"enum": ["verification", "admission", "completion", "recertification"]},
              "layer": {"enum": ["L1", "L2", "L3"]},
              "origin": {"enum": ["auto-discovered", "project-policy", "external"]},
              "evidence_id": {"type": "string"},
              "status": {"enum": ["passed", "failed", "timed_out"]}
            }
          }
        },
        "uncovered": {"type": "array", "items": {"type": "string"}}
      }
    },
    "liveness_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates_evaluated", "candidates_rejected", "checkpoints_verified", "recovered"],
      "properties": {
        "candidates_evaluated": {"type": "integer", "minimum": 0},
        "candidates_rejected": {"type": "integer", "minimum": 0},
        "checkpoints_verified": {"type": "integer", "minimum": 0},
        "recovered": {"type": "boolean"},
        "selection_reason": {"type": "string"}
      }
    },
    "receipt_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
